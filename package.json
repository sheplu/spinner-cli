{
  "name": "spinner-cli",
  "version": "1.0.0",
  "description": "Native Node.js CLI spinner implementation",
  "type": "module",
  "main": "dist/spinner.js",
  "types": "dist/spinner.d.ts",
  "exports": {
    ".": {
      "types": "./dist/spinner.d.ts",
      "default": "./dist/spinner.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "example": "tsc && node dist/example.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
